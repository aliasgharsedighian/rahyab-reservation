            "application/json": {
              "schema": {
                "required": ["mobile", "password"],
                "properties": {
                  "mobile": {
                    "type": "string",
                    "example": "09120000004"
                  },
                  "password": {
                    "type": "string",
                    "example": "password"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Inactive user"
          }
