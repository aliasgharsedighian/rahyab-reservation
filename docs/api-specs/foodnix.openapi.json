          },
          {
            "name": "food_name",
            "in": "query",
            "description": "نام غذا (جستجو)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "قرمه"
            }
          },
          {
            "name": "reserve_date_jalali",
            "in": "query",
            "description": "تاریخ رزرو دقیق (شمسی)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1404/01/15"
            }
          },
          {
            "name": "reserve_date_from_jalali",
            "in": "query",
            "description": "از تاریخ رزرو (شمسی)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1404/01/01"
            }
          },
          {
            "name": "reserve_date_to_jalali",
            "in": "query",
            "description": "تا تاریخ رزرو (شمسی)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1404/01/31"
            }
          },
          {
            "name": "quantity",
            "in": "query",
            "description": "تعداد",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 2
            }
          },
          {
            "name": "unit_price",
            "in": "query",
            "description": "قیمت واحد (همان واحد پاسخ API)",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 85000
            }
          },
          {
            "name": "total_paid",
            "in": "query",
            "description": "مبلغ کل (همان واحد پاسخ API)",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 170000
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "وضعیت رزرو",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "reserved",
                "cancelled",
                "payment_failed",
                "__pending_gateway__"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "items, pagination"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "422": {
            "description": "Validation error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
