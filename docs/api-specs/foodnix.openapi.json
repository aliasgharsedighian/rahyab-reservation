    "/api/v1/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register",
        "operationId": "acb05b754f27883511a5e25a192dd02b",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "required": ["mobile", "password", "name", "family"],
                "properties": {
                  "mobile": {
                    "type": "string",
                    "example": "09123456789"
                  },
                  "password": {
                    "type": "string",
                    "example": "12345678"
                  },
                  "name": {
                    "type": "string",
                    "example": "Ali"
                  },
                  "family": {
                    "type": "string",
                    "example": "Ahmadi"
                  }
                },
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": ["Auth"],
