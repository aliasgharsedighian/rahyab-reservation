    "/api/v1/wallet": {
      "get": {
        "tags": ["Wallet"],
        "summary": "Wallet balance, totals and transactions",
        "operationId": "c771635069ad51bbbae1a5ed286785bf",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "description": "تعداد در هر صفحه",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 100,
              "minimum": 1
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "شماره صفحه",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "شناسه تراکنش",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "نوع تراکنش",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["credit", "debit"]
            }
          },
          {
            "name": "amount",
            "in": "query",
            "description": "مبلغ (همان واحد پاسخ API)",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 10000
            }
          },
          {
            "name": "description",
            "in": "query",
            "description": "جستجو در توضیحات",
            "required": false,
            "schema": {
              "type": "string",
              "example": "شارژ"
            }
          },
          {
            "name": "created_at_jalali",
            "in": "query",
            "description": "تاریخ تراکنش دقیق (شمسی YYYY/MM/DD)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1404/01/15"
            }
          },
          {
            "name": "created_at_from_jalali",
            "in": "query",
            "description": "از تاریخ تراکنش (شمسی YYYY/MM/DD)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1404/01/01"
            }
          },
          {
            "name": "created_at_to_jalali",
            "in": "query",
            "description": "تا تاریخ تراکنش (شمسی YYYY/MM/DD)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "1404/01/31"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "balance, total_credit, total_debit, transactions, pagination"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "422": {
            "description": "Validation error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
